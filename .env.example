# ============================================================================
# HelloClaw 环境变量配置
# ============================================================================

# LLM 配置
LLM_MODEL_ID=glm-5
LLM_API_KEY=sk-b2a879e857b945bd84e32df27d2840cc
LLM_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# 服务配置
PORT=8000
CORS_ORIGINS=http://localhost:5173

# 工作空间配置
WORKSPACE_PATH=~/.helloclaw/workspace

# MongoDB 配置
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=helloclaw
# MONGO_USERNAME=                    # 用户名（可选）
# MONGO_PASSWORD=                    # 密码（可选）
# MONGO_AUTH_SOURCE=admin            # 认证源（默认 admin）
# MONGO_AUTO_START=true              # 是否自动启动 MongoDB（默认 true）
# MONGO_BIN_PATH=/path/to/mongodb/bin       # MongoDB bin 目录路径
# MONGO_DATA_PATH=/path/to/data/mongodb     # MongoDB 数据存储路径
# MONGO_LOG_PATH=/path/to/log/mongodb.log   # MongoDB 日志文件路径
